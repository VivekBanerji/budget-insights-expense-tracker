PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional: without this, transaction API uses temporary in-memory demo storage.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=budget_insights
# Optional: needed for real receipt AI and AI coach endpoints.
# Keep this secret on the server only; never add it to Vite variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
